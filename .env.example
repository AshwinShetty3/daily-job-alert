GMAIL_USER=your-address@gmail.com
EMAIL_TO=your-address@gmail.com
GMAIL_APP_PASSWORD=
GMAIL_TOKEN_JSON=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=
# Must be <= your verified FREE subscription allowance. Zero disables JSearch.
JSEARCH_MONTHLY_LIMIT=0
GMAIL_ENABLED=true
# strict: jobs without a verified posting timestamp are excluded.
# alert_received: Gmail-only fallback, explicitly labelled, NOT a verified posting date.
DATE_POLICY=strict
HIMALAYAS_PAGES=3
ADZUNA_PAGES=1
